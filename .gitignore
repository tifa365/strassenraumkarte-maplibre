# Generated artefacts
data/osm/*.osm.pbf
data/osm/*.pbf
data/parking/**
!data/parking/.gitkeep
!data/parking/reference/
!data/parking/reference/README.md
!data/parking/reference/upstream/
!data/parking/reference/upstream/street_parking.py
render/tiles/**
!render/tiles/.gitkeep
!render/tiles/preview.html
render/parking-sample*/

# Python
__pycache__/
*.py[cod]
*$py.class

# QGIS backups / working copies
*.qgz.bak*
style/*.qgz.bak*
*.bak
style/.*_work/
# Disposable per-render QGIS project copies (render/xyz_tiles.py); normally
# removed on exit, but a SIGKILLed render (e.g. an OOM) can leak these.
style/.render-*.qgs
# QGIS writes a random-named <id>_styles.db into the working directory on each
# headless run, plus a symbology database; a staged project copy is scratch too.
/*_styles.db
/symbology-style.db
/_thinned_project_staged.qgs

# Local backups / editor
backup/
.cursor/

# Local / env
data/.venv/
.pgpass

# Local notes / legacy (not for remote)
TODO.txt
todo_from_post_processing.py
style/lanes.qgz

# Parity-check reference renders and runs
render/parity-reference/
render/parity-runs/

# Raw OSM extracts (ODbL data, large) and local render output
data/osm/*.zip
data/osm/*.gpkg
render/full-*/
render/live-preview/

# Downloaded reference media
*.webm
*.mp4
